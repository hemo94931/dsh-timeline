{
  "name": "@hemo94931/dsh-timeline",
  "version": "0.2.0",
  "description": "会话时间轴：在 dsh WebUI 会话消息列右缘渲染用户消息刻度导航条（悬浮摘要 / 点击跳转 / ▲▼ 导航 / 连续位置指示）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hemo94931/dsh-timeline.git"
  },
  "bugs": {
    "url": "https://github.com/hemo94931/dsh-timeline/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "timeline",
    "webui",
    "plugin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node build.js",
    "test": "node test/model.test.js"
  }
}
